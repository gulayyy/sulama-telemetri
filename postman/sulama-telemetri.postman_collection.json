      "item": [
        {
          "name": "Acik Alarmlari Listele",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
