    {
      "name": "6. Senaryo: Sulama Alarmi",
      "description": "Ucdan uca zincirli akis. Sirali calismalidir.\n\n1. Esik altinda nem degerine sahip bir olcum yazilir\n2. Sistemin `IRRIGATION_NEEDED` alarmi uretmesi beklenir\n3. Alarm cozulur\n4. Alarmin artik acik listesinde olmadigi dogrulanir",
      "item": [
        {
          "name": "Adim 1 - Dusuk Nemli Olcum Gonder",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Esigin ALTINDA bir nem degeri uret ki alarm tetiklensin.",
                  "const esik = Number(pm.collectionVariables.get('moistureThreshold'));",
                  "const dusukNem = +(Math.max(1, esik - 10) + Math.random() * 5).toFixed(2);",
                  "",
                  "pm.variables.set('dusukNem', dusukNem);",
                  "pm.collectionVariables.set('senaryoNem', String(dusukNem));",
                  "console.log('Gonderilecek nem:', dusukNem, '(esik', esik + ')');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Kaydedilen nem esigin altinda', function () {",
                  "    const esik = Number(pm.collectionVariables.get('moistureThreshold'));",
                  "    pm.expect(body.soil_moisture).to.be.below(esik);",
                  "});",
                  "",
                  "pm.collectionVariables.set('readingId', String(body.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sensorId\": {{sensorId}},\n  \"soilMoisture\": {{dusukNem}},\n  \"temperature\": 31.4,\n  \"airHumidity\": 38.2,\n  \"battery\": 88.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/readings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "readings"]
            },
            "description": "Toprak nemi esigin altinda bir olcum yazar. API'nin bu kaydi isledikten sonra `alerts` tablosuna `IRRIGATION_NEEDED` satiri eklemesi beklenir."
          },
          "response": []
        },
        {
          "name": "Adim 2 - Alarm Uretildi mi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "const sensorId = Number(pm.collectionVariables.get('sensorId'));",
                  "const gonderilenNem = Number(pm.collectionVariables.get('senaryoNem'));",
                  "",
                  "pm.test('En az bir acik alarm var', function () {",
                  "    pm.expect(body.length).to.be.at.least(1);",
                  "});",
                  "",
                  "const alarm = body.find(function (a) {",
                  "    return a.sensor_id === sensorId && a.alert_type === 'IRRIGATION_NEEDED';",
                  "});",
                  "",
                  "pm.test('Bu sensor icin IRRIGATION_NEEDED alarmi uretilmis', function () {",
                  "    pm.expect(alarm, 'sensor ' + sensorId + ' icin alarm bulunamadi').to.not.be.undefined;",
                  "});",
                  "",
                  "if (alarm) {",
                  "    pm.test('Alarm degeri gonderilen olcumle eslesiyor', function () {",
                  "        pm.expect(alarm.value).to.eql(gonderilenNem);",
                  "    });",
                  "",
                  "    pm.test('Alarm mesaji dolu', function () {",
                  "        pm.expect(alarm.message).to.be.a('string').and.not.empty;",
                  "    });",
                  "",
                  "    pm.test('Alarm henuz cozulmemis', function () {",
                  "        pm.expect(alarm.resolved).to.eql(false);",
                  "    });",
                  "",
                  "    pm.test('Alarm az once olusturulmus (son 60 sn)', function () {",
                  "        const fark = Date.now() - new Date(alarm.created_at).getTime();",
                  "        pm.expect(fark).to.be.below(60000);",
                  "    });",
                  "",
                  "    pm.collectionVariables.set('alertId', String(alarm.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/alerts?resolved=false&sensorId={{sensorId}}",
