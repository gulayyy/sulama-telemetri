              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Esigin uzerinde, alarm tetiklemeyecek bir nem degeri uret.",
                  "const esik = Number(pm.collectionVariables.get('moistureThreshold'));",
                  "const nem = +(esik + 10 + Math.random() * 30).toFixed(2);",
                  "",
                  "pm.variables.set('rndSoilMoisture', nem);",
                  "pm.variables.set('rndTemperature', +(18 + Math.random() * 16).toFixed(2));",
                  "pm.variables.set('rndAirHumidity', +(35 + Math.random() * 40).toFixed(2));",
                  "pm.variables.set('rndBattery', +(80 + Math.random() * 20).toFixed(2));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Durum kodu 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "",
                  "pm.test('Olusturulan kaydin id degeri donuyor', function () {",
                  "    pm.expect(body).to.have.property('id');",
                  "    pm.expect(body.id).to.be.a('number');",
                  "});",
                  "",
                  "pm.test('Gonderilen degerler aynen kaydedilmis', function () {",
                  "    pm.expect(body.soil_moisture).to.eql(Number(pm.variables.get('rndSoilMoisture')));",
                  "    pm.expect(body.temperature).to.eql(Number(pm.variables.get('rndTemperature')));",
                  "});",
                  "",
                  "pm.test('Sunucu recorded_at atamis', function () {",
                  "    pm.expect(body).to.have.property('recorded_at');",
                  "    pm.expect(new Date(body.recorded_at).toString()).to.not.eql('Invalid Date');",
                  "});",
                  "",
                  "pm.test('Location basligi yeni kaynagi isaret ediyor', function () {",
                  "    const loc = pm.response.headers.get('Location');",
                  "    pm.expect(loc, 'Location basligi').to.be.a('string');",
                  "    pm.expect(loc).to.include('/api/readings/' + body.id);",
                  "});",
                  "",
                  "pm.collectionVariables.set('readingId', String(body.id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
