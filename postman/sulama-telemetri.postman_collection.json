                  "const body = pm.response.json();",
                  "",
                  "pm.test('Yanit bir dizi', function () {",
                  "    pm.expect(body).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Tum alarmlar cozulmemis (resolved = false)', function () {",
                  "    body.forEach(function (a) {",
                  "        pm.expect(a.resolved).to.eql(false);",
                  "    });",
                  "});",
                  "",
                  "pm.test('Alarm alanlari eksiksiz', function () {",
                  "    body.forEach(function (a) {",
                  "        pm.expect(a).to.have.property('id');",
                  "        pm.expect(a).to.have.property('sensor_id');",
                  "        pm.expect(a).to.have.property('alert_type');",
                  "        pm.expect(a).to.have.property('message');",
                  "        pm.expect(a).to.have.property('value');",
                  "        pm.expect(a).to.have.property('created_at');",
                  "    });",
                  "});",
                  "",
                  "pm.test('alert_type bilinen bir deger', function () {",
                  "    const gecerli = ['IRRIGATION_NEEDED', 'LOW_BATTERY', 'SENSOR_OFFLINE', 'HIGH_TEMPERATURE'];",
                  "    body.forEach(function (a) {",
                  "        pm.expect(gecerli, 'beklenmeyen tur: ' + a.alert_type).to.include(a.alert_type);",
                  "    });",
                  "});",
                  "",
                  "if (body.length > 0) {",
                  "    pm.collectionVariables.set('alertId', String(body[0].id));",
                  "    console.log('alertId =', body[0].id);",
                  "} else {",
                  "    console.log('Acik alarm yok. Senaryo klasoru bir tane uretecek.');",
                  "}"
                ]
              }
            }
