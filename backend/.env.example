# Backend ayarları — bu dosyayı .env olarak kopyalayıp değerleri düzenleyin.
PORT=4000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=sulama
PGPASSWORD=sulama123
PGDATABASE=telemetri

# MQTT
MQTT_URL=mqtt://localhost:1883
MQTT_TOPIC=farm/sensors/+

# İş kuralları
MOISTURE_THRESHOLD=25

# JWT (2. hafta)
JWT_SECRET=degistirilmesi-gereken-gizli-anahtar
JWT_EXPIRES_IN=8h
ADMIN_USER=admin
ADMIN_PASSWORD=sulama123
